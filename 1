async function getLocalInfo() {
    return jsonify({
        ver: 1,
        name: '黄果短剧',
        api: 'csp_huangguo',
        type: 3,
    })
}

async function getConfig() {
    return jsonify({
        ver: 1,
        title: '黄果短剧',
        site: SITE,
        tabs: TABS.map((t) => ({
            name: t.name,
            ext: {
                id: t.id,
            },
        })),
    })
}

async function getCards(ext) {
    ext = argsify(ext)

    const id = String(ext.id || 'home').replace(/^\//, '')
    const page = Math.max(1, parseInt(ext.page) || 1)

    try {
        let url

        if (id === 'home') {
            url = SITE + '/'
        } else {
            url =
                SITE +
                '/' +
                id +
                '/' +
                (page > 1 ? page + '/' : '')
        }

        const html = await fetchHtml(url)

        if (!html) {
            return jsonify({
                list: [],
                page: page,
            })
        }

        let list

        if (id.indexOf('rank') !== -1) {
            list = parseRanks(html)
        } else {
            list = parseGridCards(html, id === 'home')
        }

        return jsonify({
            list: list,
            page: page,
        })
    } catch (e) {
        console.error('getCards error:', e)

        return jsonify({
            list: [],
            page: page,
        })
    }
}

// ============================================================
// 剧集解析
// ============================================================

function parseEpisodeLink(tag) {
    const href =
        attr(tag, 'href') ||
        attr(tag, 'data-url') ||
        attr(tag, 'data-href') ||
        ''

    if (!href) return null

    const ep =
        attr(tag, 'data-ep-id') ||
        attr(tag, 'data-episode') ||
        attr(tag, 'data-ep') ||
        ''

    let name = ''

    if (ep) {
        name = '第' + ep + '集'
    } else {
        name = stripTags(tag)
    }

    if (!name || name.length > 30) {
        name = '第' + (parseEpisodeLink.index || 1) + '集'
    }

    parseEpisodeLink.index = (parseEpisodeLink.index || 0) + 1

    return {
        name: name,
        ext: {
            url: fix(href),
            ep: String(ep || ''),
        },
    }
}

function parseTracks(html) {
    const tracks = []

    parseEpisodeLink.index = 1

    // 优先获取剧集容器
    let containers = getBlocksByClass(html, 'hg-web-detail__ep-grid')

    if (!containers.length) {
        containers = getBlocksByClass(html, 'ep-grid')
    }

    const source = containers.length ? containers[0] : html

    // 兼容 a 标签、button、带 data-url 的元素
    const tags =
        source.match(/<(?:a|button)\b[^>]*>[\s\S]*?<\/(?:a|button)>/gi) || []

    const seen = {}

    for (const tag of tags) {
        const track = parseEpisodeLink(tag)

        if (!track || !track.ext.url) continue

        const key = track.ext.url + '|' + track.ext.ep

        if (seen[key]) continue

        seen[key] = true
        tracks.push(track)
    }

    // 详情页没有剧集网格时，尝试主播放按钮
    if (!tracks.length) {
        const playRe =
            /<(?:a|button)\b[^>]*(?:class\s*=\s*(['"])[^'"]*\bhg-web-detail__play\b[^'"]*\1|data-url\s*=)[^>]*>/gi

        let m

        while ((m = playRe.exec(html)) !== null) {
            const tag = m[0]
            const href =
                attr(tag, 'href') ||
                attr(tag, 'data-url') ||
                attr(tag, 'data-href')

            if (href) {
                tracks.push({
                    name: '第1集',
                    ext: {
                        url: fix(href),
                        ep: '1',
                    },
                })
                break
            }
        }
    }

    return tracks
}

async function getTracks(ext) {
    ext = argsify(ext)

    const id = String(ext.id || '').trim()

    if (!id) {
        return jsonify({ list: [] })
    }

    try {
        // 当前黄果视频页面使用 /video/ID/
        const url = SITE + '/video/' + id + '/'

        const html = await fetchHtml(url, SITE + '/')

        if (!html) {
            console.error('getTracks: video page is empty')
            return jsonify({ list: [] })
        }

        const tracks = parseTracks(html)

        console.error(
            'getTracks: tracks count =',
            tracks.length
        )

        if (!tracks.length) {
            return jsonify({ list: [] })
        }

        return jsonify({
            list: [
                {
                    title: '黄果短剧',
                    tracks: tracks,
                },
            ],
        })
    } catch (e) {
        console.error('getTracks error:', e)
        return jsonify({ list: [] })
    }
}

// ============================================================
// 播放地址解析
// ============================================================

function findVideoJson(html) {
    if (!html) return null

    // 兼容 id 双引号、单引号、属性顺序变化
    const patterns = [
        /<script\b[^>]*id\s*=\s*(['"])videoInitialData\1[^>]*>([\s\S]*?)<\/script>/i,
        /<script\b[^>]*id\s*=\s*(['"])videoData\1[^>]*>([\s\S]*?)<\/script>/i,
        /<script\b[^>]*type\s*=\s*(['"])application\/json\1[^>]*>([\s\S]*?)<\/script>/i,
    ]

    for (const re of patterns) {
        const m = html.match(re)

        if (!m) continue

        let raw = m[2]
            .trim()
            .replace(/&quot;/gi, '"')
            .replace(/&amp;/gi, '&')

        try {
            return JSON.parse(raw)
        } catch (e) {
            // 尝试提取 JSON 对象
            const start = raw.indexOf('{')
            const end = raw.lastIndexOf('}')

            if (start >= 0 && end > start) {
                try {
                    return JSON.parse(raw.slice(start, end + 1))
                } catch (e2) {}
            }
        }
    }

    return null
}

function findPlayUrl(data, ep) {
    if (!data) return ''

    let play = ''

    // 常见结构
    const srcs =
        data.epPlaySrcs ||
        data.episodePlaySrcs ||
        data.playSrcs ||
        data.episodes ||
        {}

    if (Array.isArray(srcs)) {
        const item =
            srcs[parseInt(ep) - 1] ||
            srcs[0]

        if (typeof item === 'string') {
            play = item
        } else if (item) {
            play =
                item.url ||
                item.src ||
                item.playUrl ||
                item.videoSrc ||
                ''
        }
    } else if (typeof srcs === 'object') {
        const item = srcs[ep] || srcs[String(ep)]

        if (typeof item === 'string') {
            play = item
        } else if (item) {
            play =
                item.url ||
                item.src ||
                item.playUrl ||
                item.videoSrc ||
                ''
        }
    }

    // 兼容直接字段
    if (!play) {
        play =
            data.videoSrc ||
            data.videoUrl ||
            data.playUrl ||
            data.m3u8 ||
            data.url ||
            ''
    }

    // 递归兼容 data 嵌套
    if (!play && data.data) {
        play = findPlayUrl(data.data, ep)
    }

    if (!play) return ''

    play = decodeText(play)

    // 从字符串中提取 URL
    const urlM = play.match(/https?:\/\/[^\s"'<>]+/i)

    return urlM ? urlM[0] : ''
}

async function getPlayinfo(ext) {
    ext = argsify(ext)

    const url = String(ext.url || '').trim()
    const ep = String(ext.ep || '1')

    if (!url) {
        console.error('getPlayinfo: url is empty')
        return jsonify({ urls: [] })
    }

    try {
        console.error('getPlayinfo: request url =', url)

        // 如果上游已经直接传入 m3u8，直接返回
        if (/\.m3u8(?:\?|$)/i.test(url)) {
            return jsonify({
                urls: [url],
                headers: [
                    {
                        'User-Agent': UA,
                        'Referer': SITE + '/',
                    },
                ],
            })
        }

        const html = await fetchHtml(url, SITE + '/')

        console.error(
            'getPlayinfo: html length =',
            html ? html.length : 0
        )

        if (!html) {
            return jsonify({ urls: [] })
        }

        const data = findVideoJson(html)

        let play = findPlayUrl(data, ep)

        // 兜底：从 HTML 中直接搜索 m3u8
        if (!play) {
            const m3u8M = html.match(
                /https?:\/\/[^"'\\\s<>]+\.m3u8(?:\?[^"'\\\s<>]*)?/i
            )

            if (m3u8M) {
                play = decodeText(m3u8M[0])
            }
        }

        if (!play) {
            console.error(
                'getPlayinfo: play url not found'
            )
            return jsonify({ urls: [] })
        }

        console.error(
            'getPlayinfo: play url =',
            play
        )

        return jsonify({
            urls: [play],
            headers: [
                {
                    'User-Agent': UA,
                    'Referer': SITE + '/',
                },
            ],
        })
    } catch (e) {
        console.error('getPlayinfo error:', e)
        return jsonify({ urls: [] })
    }
}
