async function search(ext) {
    ext = argsify(ext)

    const kw = String(ext.text || ext.wd || '').trim()

    if (!kw) {
        return jsonify({
            list: [],
            page: 1,
        })
    }

    try {
        const url =
            SITE +
            '/search/video/' +
            encodeURIComponent(kw) +
            '/'

        const html = await fetchHtml(url, SITE + '/')
        const list = parseGridCards(html, false)

        return jsonify({
            list: list,
            page: 1,
        })
    } catch (e) {
        console.error('search error:', e)

        return jsonify({
            list: [],
            page: 1,
        })
    }
}
